# Copy to .env and fill in locally. Never commit real keys.
OPENAI_API_KEY=
RELAY_API_KEY=
DEEPSEEK_API_KEY=
VASP_AGENT_PROFILE=official
# Optional overrides (existing process environment wins over .env):
# VASP_AGENT_MODEL=your-model-id
# VASP_AGENT_BASE_URL=https://your-relay.example/v1
# VASP_AGENT_PROTOCOL=chat_completions
# VASP_AGENT_NETWORK_MODE=auto
# direct disables application proxies for this Agent's API client only; TLS verification remains enabled.
# VASP_AGENT_COMPACTION_MODE=summary
# VASP_AGENT_RECENT_CONTEXT_TOKENS=12000
