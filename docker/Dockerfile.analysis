FROM python:3.12-slim

# Lightweight offline-ready scientific analysis sandbox image for vasp-band-agent.
# Build locally once (never auto-pulled by the agent):
#   docker build -t vasp-agent-sci:latest -f docker/Dockerfile.analysis docker
# Contains no host workspace files, no VASP credentials, and no network tools.

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLBACKEND=Agg \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

RUN pip install --no-cache-dir \
        "numpy>=1.26,<3" \
        "scipy>=1.12,<2" \
        "matplotlib>=3.8,<4" && \
    MPLCONFIGDIR=/tmp/mpl python -I -B -c "import numpy, scipy, matplotlib; import matplotlib.pyplot as plt; print(numpy.__version__, scipy.__version__, matplotlib.__version__)" && \
    rm -rf /tmp/mpl

USER 65534:65534
WORKDIR /analysis
